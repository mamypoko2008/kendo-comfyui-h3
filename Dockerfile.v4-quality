# Quality edition: the V3 generation stack with the full Singularity V2 BF16 checkpoint.
# No LTX, RTX VSR, or other upscale nodes are installed.
FROM ghcr.io/mamypoko2008/kendo-comfyui-h3:v3.0.0-beta.15
ENV KENDO_IMAGE_VERSION=4.1.0-quality.3 \
    KENDO_MODEL_PROFILE=quality \
    KENDO_AUTO_DOWNLOAD_MODELS=1 \
    KENDO_WAIT_FOR_MODELS=0 \
    KENDO_ENABLE_SAGE=1 \
    KENDO_ENABLE_IMAGES=0 \
    KENDO_MCP_HOST=0.0.0.0 \
    KENDO_MCP_PORT=3001 \
    KENDO_COMFY_LOG_FILE=/workspace/comfyui.log
COPY scripts/models_v3_beta.py scripts/download_models_v3_beta.py scripts/detect_runpod_runtime.py /opt/kendo/
COPY scripts/download-v3-beta.sh /opt/kendo/download-models.sh
COPY scripts/page_server.py /opt/kendo/page_server_base.py
COPY scripts/page_server_v3_beta.py /opt/kendo/page_server.py
COPY web/v3-beta.html /opt/kendo-page/index.html
COPY web/v3-beta.css web/v3-beta.js web/workflow-v3-beta.js web/runtime-v4-local.js /opt/kendo-page/
COPY web/files.html web/files.js /opt/kendo-page/
COPY mcp/server.mjs mcp/kie-client.mjs mcp/kie-tools.mjs mcp/image-tools.mjs mcp/image-models.mjs /opt/kendo-mcp/
COPY scripts/entrypoint-v3-beta.sh /opt/kendo/entrypoint-v3-beta.sh
RUN chmod 0755 /opt/kendo/download-models.sh /opt/kendo/entrypoint-v3-beta.sh /opt/kendo/detect_runpod_runtime.py
EXPOSE 3000 3001 8188 8888 22
ENTRYPOINT ["/opt/kendo/entrypoint-v3-beta.sh"]
