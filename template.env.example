# RunPod Template environment variables
KENDO_ENABLE_SAGE=1
KENDO_AUTO_DOWNLOAD_MODELS=1
KENDO_WAIT_FOR_MODELS=1

# Set strong values in RunPod Secrets or Template environment settings.
JUPYTER_PASSWORD=CHANGE_ME
FILEBROWSER_PASSWORD=CHANGE_ME

# Optional: add an SSH public key through RunPod Secrets.
# PUBLIC_KEY=ssh-ed25519 AAAA...
