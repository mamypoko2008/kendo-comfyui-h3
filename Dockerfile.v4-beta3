# Kendo H3 V4 beta.3: V3 video experience plus official MiniMax H3 Image.
FROM ghcr.io/mamypoko2008/kendo-comfyui-h3:v3.0.0-beta.17

ARG COMFYUI_VERSION=v0.45.0
ARG WORKFLOW_TEMPLATES_COMMIT=a8bc07a76478dfada740fa8fa49ac87be1bff519
ENV KENDO_IMAGE_VERSION=4.0.0-beta.3 \
    KENDO_MODEL_PROFILE=v4-beta3 \
    KENDO_DUAL_PASS=0 \
    KENDO_WORKFLOW_FILE=/opt/kendo-page/workflow-v3-beta.js \
    KENDO_AUTO_DOWNLOAD_MODELS=1 \
    KENDO_WAIT_FOR_MODELS=0 \
    KENDO_ENABLE_SAGE=1 \
    KENDO_ENABLE_IMAGES=1 \
    KENDO_IMAGE_MODELS="" \
    KENDO_IMAGE_DEFAULT_MODEL=h3image \
    KENDO_IMAGE_DEFAULT_RESOLUTION=2K \
    KENDO_IMAGE_PAGE_PATH=/h3-image.html \
    KENDO_IMAGE_WORKFLOW_FILE=/opt/kendo-page/workflow-h3-image.js \
    KENDO_MCP_HOST=0.0.0.0 \
    KENDO_MCP_NAME="Kendo V4 MiniMax H3 Video + Image"

USER root
# Native H3 Image nodes require ComfyUI 0.45.0+. Preserve the proven video
# custom nodes and user workflows from the V3 base while replacing only core.
RUN set -eux; \
    git clone --depth 1 --branch "${COMFYUI_VERSION}" https://github.com/Comfy-Org/ComfyUI.git /tmp/ComfyUI; \
    cp -a /opt/comfyui-baked/custom_nodes/. /tmp/ComfyUI/custom_nodes/; \
    if [ -d /opt/comfyui-baked/user ]; then mkdir -p /tmp/ComfyUI/user; cp -a /opt/comfyui-baked/user/. /tmp/ComfyUI/user/; fi; \
    rm -rf /opt/comfyui-baked; \
    mv /tmp/ComfyUI /opt/comfyui-baked; \
    python3.12 -m pip install --no-cache-dir -r /opt/comfyui-baked/requirements.txt; \
    workflow_dir=/opt/comfyui-baked/user/default/workflows; \
    mkdir -p "$workflow_dir"; \
    curl -fSL "https://raw.githubusercontent.com/Comfy-Org/workflow_templates/${WORKFLOW_TEMPLATES_COMMIT}/templates/image_minimax_h3_image_t2i.json" -o "$workflow_dir/KENDO_MiniMax_H3_Image_T2I.json"; \
    curl -fSL "https://raw.githubusercontent.com/Comfy-Org/workflow_templates/${WORKFLOW_TEMPLATES_COMMIT}/templates/image_minimax_h3_image_edit.json" -o "$workflow_dir/KENDO_MiniMax_H3_Image_Edit.json"; \
    printf '%s\n' "${COMFYUI_VERSION}" "${WORKFLOW_TEMPLATES_COMMIT}" > /opt/comfyui-baked/.kendo-v4-beta3-core

# The same MCP endpoint advertises both kendo_generate and kendo_image_* tools.
COPY mcp/server.mjs mcp/image-tools.mjs /opt/kendo-mcp/
COPY scripts/models_v4_beta3.py scripts/download_models_v4_beta3.py scripts/page_server_v3_beta.py scripts/page_server_v4_beta3.py /opt/kendo/
COPY scripts/download-v4-beta3.sh /opt/kendo/download-models.sh
COPY scripts/page_server_v4_beta3.py /opt/kendo/page_server.py
COPY scripts/entrypoint-v4-beta3.sh /opt/kendo/entrypoint-v4-beta3.sh

COPY web/v3-beta.html /opt/kendo-page/index.html
COPY web/v3-beta.html /opt/kendo-page/v4-beta3.html
COPY web/v3-beta.css web/v3-beta.js web/workflow-v3-beta.js web/runtime-v4-local.js /opt/kendo-page/
COPY web/files.html web/files.js web/images-v4.css web/h3-image.html web/h3-image.css web/h3-image.js web/workflow-h3-image.js /opt/kendo-page/

# Keep the V3 interaction model, but expose only the original H3 video model and
# add the H3 Image mode. The separate V3 image/template is never modified.
RUN set -eux; \
    for page in /opt/kendo-page/index.html /opt/kendo-page/v4-beta3.html; do \
      sed -i 's#Kendo Studio | H3 Fast v3 beta#Kendo Studio | H3 Video + Image V4 beta.3#' "$page"; \
      sed -i 's#MiniMax H3 · Fast v3 beta#MiniMax H3 · V4 beta.3#' "$page"; \
      sed -i 's#<a class="active" href="/v3-beta.html">สร้างงาน</a>#<a class="active" href="/v4-beta3.html">วิดีโอ H3</a><a href="/h3-image.html">ภาพนิ่ง H3-Image</a>#' "$page"; \
      sed -i 's#<option value="singularity">Singularity V2 · 20 GB</option>##' "$page"; \
      sed -i 's#v=4.1.6#v=4.0.0-beta.3#g' "$page"; \
    done; \
    chmod 0755 /opt/kendo/download-models.sh /opt/kendo/entrypoint-v4-beta3.sh; \
    python3.12 -m compileall -q /opt/kendo

ENTRYPOINT ["/opt/kendo/entrypoint-v4-beta3.sh"]
