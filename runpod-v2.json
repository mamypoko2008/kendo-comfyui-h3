{
  "name": "Kendo-ComfyUI-H3 Fast v2",
  "imageName": "ghcr.io/mamypoko2008/kendo-comfyui-h3:v2.0.0",
  "containerDiskInGb": 30,
  "volumeInGb": 100,
  "volumeMountPath": "/workspace",
  "ports": "3000/http,8188/http,8888/http,22/tcp",
  "isPublic": true,
  "isServerless": false,
  "env": [
    {"key": "KENDO_ENABLE_SAGE", "value": "1"},
    {"key": "KENDO_AUTO_DOWNLOAD_MODELS", "value": "1"},
    {"key": "KENDO_WAIT_FOR_MODELS", "value": "0"}
  ]
}
