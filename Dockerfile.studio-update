# Keep the published ComfyUI runtime and add cloud image generation through KIE.
FROM ghcr.io/mamypoko2008/kendo-comfyui-h3:v3.1.0-studio.3
COPY web/seedance25.html /opt/kendo-page/seedance25.html
COPY web/seedance25.html /opt/kendo-page/index.html
COPY web/images.html /opt/kendo-page/images.html
COPY web/images.js web/seedance25.js web/studio-connection.js web/seedance25.css /opt/kendo-page/
COPY mcp/server.mjs mcp/kie-client.mjs mcp/kie-tools.mjs mcp/studio-server.mjs mcp/image-models.mjs /opt/kendo-mcp/
ENV KENDO_ENABLE_IMAGES=0 KENDO_IMAGE_MODELS="" KENDO_IMAGE_VERSION=3.1.0-studio.4 KENDO_AUTO_DOWNLOAD_MODELS=0 KENDO_MCP_NAME="Kendo-Seedance 2.5"
